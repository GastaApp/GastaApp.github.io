@using GastaApp.Components
@inherits LayoutComponentBase
@inject GastaApp.Services.AddExpenseUiService AddExpenseUi
@inject GastaApp.Services.UserProfileService UserProfile
@inject GastaApp.Services.AccentColorService AccentColor
@inject NavigationManager Nav
@implements IDisposable

<div class="app-content">
    @Body

    <AlertView />
    <AddExpenseSheet IsOpen="AddExpenseUi.IsOpen" IsOpenChanged="OnSheetOpenChanged"
                     Category="AddExpenseUi.Category" OnSaved="OnExpenseSaved" />
</div>

<nav class="bottom-nav">
    <NavLink href="" class="nav-item" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <path d="M3 10.5 12 3l9 7.5" />
            <path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5" />
        </svg>
    </NavLink>

    <NavLink href="alltransactions" class="nav-item" Match="NavLinkMatch.All">
         <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <line x1="3" y1="10" x2="21" y2="10" />
            <line x1="7" y1="15" x2="11" y2="15" />
        </svg>
    </NavLink>

    <button class="nav-item nav-item-add" @onclick="() => AddExpenseUi.Open()" aria-label="Add expense">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" width="22" height="22">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
        </svg>
    </button>

    <NavLink href="stats" class="nav-item" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">
            <line x1="6" y1="20" x2="6" y2="14" />
            <line x1="12" y1="20" x2="12" y2="8" />
            <line x1="18" y1="20" x2="18" y2="11" />
        </svg>
    </NavLink>

    <NavLink href="settings" class="nav-item" Match="NavLinkMatch.All">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
            <circle cx="12" cy="12" r="3" />
        </svg>
    </NavLink>
</nav>

@code {
    protected override async Task OnInitializedAsync()
    {
        AddExpenseUi.OnChanged += HandleChanged;
        await AccentColor.ApplyCurrentAsync();

        // Only pages using THIS layout hit this check — OnboardingPage declares its
        // own @layout, so it never runs through here, no route-string comparison or
        // loop-guard needed.
        if (!await UserProfile.IsOnboardedAsync())
        {
            Nav.NavigateTo("onboarding", forceLoad: false);
        }
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private void OnSheetOpenChanged(bool open)
    {
        if (!open) AddExpenseUi.Close();
    }

    private void OnExpenseSaved() => AddExpenseUi.RaiseSaved();

    public void Dispose() => AddExpenseUi.OnChanged -= HandleChanged;
}