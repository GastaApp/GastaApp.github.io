@page "/alltransactions"
@using GastaApp.Components
@using GastaApp.Services
@inject GastaApp.Services.ExpenseSummaryService SummaryService
@inject GastaApp.Data.Repositories.IExpenseRepository ExpenseRepository
@inject GastaApp.Data.Repositories.ICategoryRepository CategoryRepository
@inject GastaApp.Data.Repositories.IPaymentMethodRepository PaymentMethodRepository
@inject GastaApp.Services.AlertService Alert
@inject GastaApp.Services.AddExpenseUiService AddExpenseUi
@implements IDisposable

<div class="top-fixed">
<div class="header">
    <span class="screen-title">All Expenses</span>
    <div class="month-switcher">
        <span @onclick="PreviousMonth">&#10094;</span>
        <strong>@SelectedMonth.ToString("MMMM")</strong>
        <span style="text-align:end;" @onclick="NextMonth">&#10095;</span>
    </div>
</div>

<div class="total-card">
    <svg class="total-card-chip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28">
        <rect x="2" y="5" width="20" height="14" rx="2.5" />
        <line x1="2" y1="10" x2="22" y2="10" />
    </svg>
    <span class="total-label">TOTAL THIS MONTH</span>
    <span class="total-amount">@Total.ToString("₱#,##0.00")</span>
</div>

<div class="toolbar-row">
    <span class="count-text">@FilteredTransactions.Count expense@(FilteredTransactions.Count == 1 ? "" : "s")</span>
    <div class="toolbar-buttons">
        <button class="toolbar-btn @(HasActiveFilter ? "active" : "")" @onclick="() => ShowFilter = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                <polygon points="4 4 20 4 14 12 14 19 10 21 10 12 4 4" />
            </svg>
            Filter@(HasActiveFilter ? " •" : "")
        </button>
        <button class="toolbar-btn" @onclick="() => ShowSort = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
                <line x1="4" y1="7" x2="14" y2="7" />
                <line x1="4" y1="12" x2="11" y2="12" />
                <line x1="4" y1="17" x2="8" y2="17" />
                <polyline points="18 4 18 20" />
                <polyline points="14 16 18 20 22 16" />
            </svg>
            @SortLabel
        </button>
    </div>
    </div>
</div>

<div class="transaction-list">
    @if (FilteredTransactions.Count == 0)
    {
        <div class="empty-state">No expenses match.</div>
    }
    @foreach (var item in FilteredTransactions)
    {
        <SwipeableTransactionRow Item="item" OnTap="OpenEdit" OnDelete="DeleteExpense" ShowPaymentMethod="true" />
    }
</div>

<EditExpenseSheet @bind-IsOpen="ShowEdit" ExpenseId="EditingExpenseId" OnSaved="LoadAsync" />

<SortSheet @bind-IsOpen="ShowSort" Title="Sort Expenses" Choices="SortChoices"
           SelectedValue="@SortMode.ToString()" OnSelected="OnSortSelected" />

<FilterSheet @bind-IsOpen="ShowFilter" Categories="Categories" PaymentMethods="PaymentMethods"
             SelectedCategoryId="FilterCategoryId" SelectedPaymentMethodId="FilterPaymentMethodId"
             OnApplied="OnFilterApplied" />

@code {
    private enum SortOption { Recent, Oldest, AmountHigh, AmountLow }

    private static readonly List<(string Value, string Label)> SortChoices = new()
    {
        (SortOption.Recent.ToString(), "Most Recent"),
        (SortOption.Oldest.ToString(), "Oldest"),
        (SortOption.AmountHigh.ToString(), "Amount: High to Low"),
        (SortOption.AmountLow.ToString(), "Amount: Low to High"),
    };

    private DateTime SelectedMonth = DateTime.Now;
    private List<ExpenseListItem> Transactions = new();
    private List<ExpenseListItem> FilteredTransactions = new();
    private decimal Total;
    private SortOption SortMode = SortOption.Recent;

    private List<GastaApp.Models.Category> Categories = new();
    private List<GastaApp.Models.PaymentMethod> PaymentMethods = new();
    private int? FilterCategoryId;
    private int? FilterPaymentMethodId;
    private bool HasActiveFilter => FilterCategoryId.HasValue || FilterPaymentMethodId.HasValue;

    private bool ShowEdit;
    private bool ShowSort;
    private bool ShowFilter;
    private int EditingExpenseId;

    private string SortLabel => SortChoices.First(c => c.Value == SortMode.ToString()).Label;

    protected override async Task OnInitializedAsync()
    {
        Categories = await CategoryRepository.GetActiveOrderedAsync();
        PaymentMethods = await PaymentMethodRepository.GetActiveOrderedAsync();
        await LoadAsync();
        AddExpenseUi.OnExpenseSaved += HandleExpenseSaved;
    }

    private async void HandleExpenseSaved() => await InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        Transactions = await SummaryService.GetAllTransactionsForMonthAsync(SelectedMonth.Year, SelectedMonth.Month);
        Total = Transactions.Sum(t => t.Amount);
        ApplyFilterAndSort();
        StateHasChanged();
    }

    private void ApplyFilterAndSort()
    {
        var query = Transactions.AsEnumerable();

        if (FilterCategoryId.HasValue)
            query = query.Where(t => t.CategoryId == FilterCategoryId);
        if (FilterPaymentMethodId.HasValue)
            query = query.Where(t => t.PaymentMethodId == FilterPaymentMethodId);

        query = SortMode switch
        {
            SortOption.Recent => query.OrderByDescending(t => t.Date),
            SortOption.Oldest => query.OrderBy(t => t.Date),
            SortOption.AmountHigh => query.OrderByDescending(t => t.Amount),
            SortOption.AmountLow => query.OrderBy(t => t.Amount),
            _ => query
        };

        FilteredTransactions = query.ToList();
    }

    private void OnSortSelected(string value)
    {
        if (Enum.TryParse<SortOption>(value, out var mode))
            SortMode = mode;
        ApplyFilterAndSort();
    }

    private void OnFilterApplied((int? CategoryId, int? PaymentMethodId) filter)
    {
        FilterCategoryId = filter.CategoryId;
        FilterPaymentMethodId = filter.PaymentMethodId;
        ApplyFilterAndSort();
    }

    private async Task PreviousMonth() { SelectedMonth = SelectedMonth.AddMonths(-1); await LoadAsync(); }
    private async Task NextMonth() { SelectedMonth = SelectedMonth.AddMonths(1); await LoadAsync(); }

    private void OpenEdit(int expenseId)
    {
        EditingExpenseId = expenseId;
        ShowEdit = true;
    }

    private async Task DeleteExpense(int expenseId)
    {
        await ExpenseRepository.DeleteAsync(expenseId);
        await LoadAsync();
    }

    public void Dispose() => AddExpenseUi.OnExpenseSaved -= HandleExpenseSaved;
}