@page "/expenselist"
@using GastaApp.Components
@inject GastaApp.Services.ExpenseSummaryService SummaryService
@inject GastaApp.Data.Repositories.IPaymentMethodRepository PaymentMethodRepository
@inject GastaApp.Data.Repositories.IExpenseRepository ExpenseRepository
@inject GastaApp.Services.AlertService Alert
@inject NavigationManager Nav

<div class="header-bar" style="background:@(_paymentMethod?.ColorKey ?? "#5B7FE8");">
    <button class="icon-btn" @onclick="GoBack">&#10094;</button>

    @if (_paymentMethod is not null)
    {
        <PaymentMethodIcon LogoImage="@_paymentMethod.LogoImage" Name="@_paymentMethod.Name" ColorKey="@_paymentMethod.ColorKey"
                           ShowBackground="false" ShowLabelWithFallback="true" Size="28" />
    }

    <div class="header-actions">
        <button class="icon-btn" @onclick="OnEditPaymentMethod">&#9998;</button>
        @* <button class="icon-btn" @onclick="GoBack">&#10005;</button> *@
    </div>
</div>

<div class="total-card">
    <svg class="total-card-chip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28">
        <rect x="2" y="5" width="20" height="14" rx="2.5" />
        <line x1="2" y1="10" x2="22" y2="10" />
    </svg>
    <span class="total-label">TOTAL THIS MONTH</span>
    <span class="total-amount">@Total.ToString("₱#,##0.00")</span>
</div> 

<div class="transaction-list">
    @if (Transactions.Count == 0)
    {
        <div class="empty-state">No transactions yet this month.</div>
    }
    @foreach (var item in Transactions)
    {
        <SwipeableTransactionRow Item="item" OnTap="OpenEdit" OnDelete="DeleteExpense" />
    }
</div>

<EditExpenseSheet @bind-IsOpen="ShowEdit" ExpenseId="EditingExpenseId" OnSaved="LoadAsync" />
<PaymentMethodEditSheet @bind-IsOpen="ShowEditPaymentMethod" PaymentMethodId="PaymentMethodId" OnSaved="LoadAsync" />

@code {
    [SupplyParameterFromQuery(Name = "paymentMethodId")]
    [Parameter]
    public int PaymentMethodId { get; set; }

    private GastaApp.Models.PaymentMethod? _paymentMethod;
    private List<GastaApp.Services.ExpenseListItem> Transactions = new();
    private decimal Total;

    private readonly DateTime Now = DateTime.Now;

    private bool ShowEdit;
    private bool ShowEditPaymentMethod;
    private int EditingExpenseId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _paymentMethod = await PaymentMethodRepository.GetByIdAsync(PaymentMethodId);
        Transactions = await SummaryService.GetTransactionsForPaymentMethodAsync(Now.Year, Now.Month, PaymentMethodId);
        Total = Transactions.Sum(t => t.Amount);
    }

    private async Task DeleteExpense(int expenseId)
    {
        await ExpenseRepository.DeleteAsync(expenseId);
        await LoadAsync();
    }

    private void OpenEdit(int expenseId)
    {
        EditingExpenseId = expenseId;
        ShowEdit = true;
    }

    private async Task OnEditPaymentMethod()
    {
        // Manage Payment Methods isn't built yet — same "Coming soon" pattern as Settings.
        // await Alert.ShowAsync("Editing payment methods is coming soon.", "Coming Soon"); 
        ShowEditPaymentMethod = true;
    }

    private void GoBack() => Nav.NavigateTo("");
}
